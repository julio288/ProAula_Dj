# Monitoreo de red para Windows Server.
# Formato por destino: nombre|host|puerto|TCP|descripción;nombre|host|puerto|TCP|descripción
# Dejar vacío hasta conocer las direcciones reales del servidor y los puertos autorizados.
MONITORING_TARGETS=
MONITORING_POLL_INTERVAL=30s
MONITORING_CONNECT_TIMEOUT=2s
MONITORING_WINDOWS_EVENT_LOG_ENABLED=true
MONITORING_WINDOWS_EVENT_LOG_CHANNELS=System,Application,Security
